# Leave empty in development: requests go to /api and Vite proxies them to the backend.
# Set to the full API URL when the frontend and backend are deployed on different origins,
# for example: VITE_API_BASE_URL=https://api.your-clinic.example/api
VITE_API_BASE_URL=

# Optional: a Google Maps embed URL for the contact section (see README).
VITE_MAP_EMBED_URL=
