# Copy to backend/.env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Set to 1 when running behind a reverse proxy (needed for correct client IPs in rate limiting)
TRUST_PROXY=0

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dental_app
DB_PASSWORD=change_me
DB_NAME=dental_clinic

# Admin JWT auth (use at least 32 random characters, e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRES_IN=8h

# Optional confirmation emails. Leave SMTP_HOST empty to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Your Dental Clinic <no-reply@your-clinic.example>"

# Clinic name used in email templates
CLINIC_NAME=Your Dental Clinic

# Address that receives contact-form enquiries (required for the contact form to send).
CLINIC_EMAIL=REPLACE_clinic_inbox@your-clinic.example
